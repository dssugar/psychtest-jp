{
  "name": "psychtest-jp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 4001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib data functions",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "preview": "npm run build && wrangler pages dev out --compatibility-flag=nodejs_compat --port=8788",
    "preview:functions": "wrangler pages dev out --compatibility-flag=nodejs_compat --port=8788",
    "db:migrate:local": "wrangler d1 migrations apply psychtest-alpha --local",
    "db:migrate:remote": "wrangler d1 migrations apply psychtest-alpha --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "db:seed:build": "tsx scripts/seed-ipip.ts",
    "db:seed:local": "npm run db:seed:build && wrangler d1 execute psychtest-alpha --local --file=scripts/.cache/seed-ipip.sql",
    "db:seed:remote": "npm run db:seed:build && wrangler d1 execute psychtest-alpha --remote --file=scripts/.cache/seed-ipip.sql",
    "eval": "node tests/eval/full.mjs",
    "eval:raw": "node tests/eval/run.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cloudflare/pages-plugin-vercel-og": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260516.1",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.92.0",
    "xlsx": "^0.18.5"
  }
}
